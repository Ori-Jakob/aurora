# Checks that every frame row of an aurora_gxreplay cpu_zones.json has the given counts:
#   cmake -DZONES=<cpu_zones.json> -DCOUNTS=<key>=<value>[,<key>=<value>...] -P check_cpu_zone_counts.cmake
cmake_minimum_required(VERSION 3.25)

foreach (_var IN ITEMS ZONES COUNTS)
  if (NOT DEFINED ${_var})
    message(FATAL_ERROR "check_cpu_zone_counts: -D${_var}=... is required")
  endif ()
endforeach ()
if (NOT EXISTS "${ZONES}")
  message(FATAL_ERROR "check_cpu_zone_counts: ${ZONES} does not exist")
endif ()

file(READ "${ZONES}" _json)
string(JSON _runCount LENGTH "${_json}" runs)
if (_runCount EQUAL 0)
  message(FATAL_ERROR "check_cpu_zone_counts: ${ZONES} has no runs")
endif ()
string(REPLACE "," ";" _counts "${COUNTS}")

math(EXPR _lastRun "${_runCount} - 1")
set(_rows 0)
set(_failures 0)
foreach (_r RANGE ${_lastRun})
  string(JSON _run GET "${_json}" runs ${_r} run)
  string(JSON _frameCount LENGTH "${_json}" runs ${_r} frames)
  if (_frameCount EQUAL 0)
    message(FATAL_ERROR "check_cpu_zone_counts: run ${_run} has no frames")
  endif ()
  math(EXPR _lastFrame "${_frameCount} - 1")
  foreach (_f RANGE ${_lastFrame})
    string(JSON _frame GET "${_json}" runs ${_r} frames ${_f} frame)
    foreach (_count IN LISTS _counts)
      string(REPLACE "=" ";" _pair "${_count}")
      list(GET _pair 0 _key)
      list(GET _pair 1 _expected)
      string(JSON _value GET "${_json}" runs ${_r} frames ${_f} ${_key})
      if (NOT _value EQUAL _expected)
        message(SEND_ERROR "run ${_run} frame ${_frame}: ${_key} = ${_value}, expected ${_expected}")
        math(EXPR _failures "${_failures} + 1")
      endif ()
    endforeach ()
    math(EXPR _rows "${_rows} + 1")
  endforeach ()
endforeach ()
if (_failures GREATER 0)
  message(FATAL_ERROR "check_cpu_zone_counts: ${_failures} counts differ across ${_rows} rows")
endif ()
message(STATUS "check_cpu_zone_counts: ${_rows} rows match ${COUNTS}")
