# Compares one key of every frame in two aurora_gxreplay frames.json files:
#   cmake -DA=<frames.json> -DB=<frames.json> -DKEY=<key> [-DMINUS_A=<key>] [-DOFFSET=<n>]
#         -P compare_replay_frames.cmake
# Every frame must satisfy A[KEY] - A[MINUS_A] == B[KEY] + OFFSET.
cmake_minimum_required(VERSION 3.25)

foreach (_var IN ITEMS A B KEY)
  if (NOT DEFINED ${_var})
    message(FATAL_ERROR "compare_replay_frames: -D${_var}=... is required")
  endif ()
endforeach ()
if (NOT DEFINED OFFSET)
  set(OFFSET 0)
endif ()
foreach (_file IN ITEMS "${A}" "${B}")
  if (NOT EXISTS "${_file}")
    message(FATAL_ERROR "compare_replay_frames: ${_file} does not exist")
  endif ()
endforeach ()

file(READ "${A}" _jsonA)
file(READ "${B}" _jsonB)
string(JSON _countA LENGTH "${_jsonA}" frames)
string(JSON _countB LENGTH "${_jsonB}" frames)
if (_countA EQUAL 0 OR NOT _countA EQUAL _countB)
  message(FATAL_ERROR "compare_replay_frames: ${A} has ${_countA} frames and ${B} has ${_countB}")
endif ()

set(_label "${KEY}")
if (DEFINED MINUS_A)
  set(_label "${KEY} - ${MINUS_A}")
endif ()
math(EXPR _last "${_countA} - 1")
set(_failures 0)
foreach (_i RANGE ${_last})
  string(JSON _valueA GET "${_jsonA}" frames ${_i} ${KEY})
  string(JSON _valueB GET "${_jsonB}" frames ${_i} ${KEY})
  if (DEFINED MINUS_A)
    string(JSON _minus GET "${_jsonA}" frames ${_i} ${MINUS_A})
    math(EXPR _valueA "${_valueA} - ${_minus}")
  endif ()
  math(EXPR _expected "${_valueB} + ${OFFSET}")
  if (NOT _valueA EQUAL _expected)
    message(SEND_ERROR "frame ${_i}: A ${_label} = ${_valueA}, B ${KEY} + ${OFFSET} = ${_expected}")
    math(EXPR _failures "${_failures} + 1")
  endif ()
endforeach ()
if (_failures GREATER 0)
  message(FATAL_ERROR "compare_replay_frames: ${_failures} of ${_countA} frames differ")
endif ()
message(STATUS "compare_replay_frames: ${_countA} frames match on A ${_label} == B ${KEY} + ${OFFSET}")
