if (CMAKE_SCRIPT_MODE_FILE)
  # Script mode starts with every policy unset, which breaks IN_LIST
  cmake_minimum_required(VERSION 3.25)
  file(STRINGS "${AURORA_WGSL_LIST}" _sources)
  list(REMOVE_ITEM _sources "")
  list(SORT _sources)
  string(REPEAT "0x[0-9a-f][0-9a-f]," 16 _row)
  set(_ids "")
  set(_arrays "")
  set(_entries "")
  set(_index 0)
  foreach (_source IN LISTS _sources)
    file(RELATIVE_PATH _rel "${AURORA_WGSL_ROOT}" "${_source}")
    if (_rel MATCHES "^\\.\\./")
      message(FATAL_ERROR "WGSL source ${_source} is outside ${AURORA_WGSL_ROOT}")
    endif ()
    string(REGEX REPLACE "\\.wgsl$" "" _id "${_rel}")
    string(REGEX REPLACE "^shaders/" "" _id "${_id}")
    if (NOT _id MATCHES "^[a-z0-9_]+(/[a-z0-9_]+)*$")
      message(FATAL_ERROR "Invalid WGSL shader id '${_id}' (${_source})")
    endif ()
    if (_id IN_LIST _ids)
      message(FATAL_ERROR "Duplicate WGSL shader id '${_id}' (${_source})")
    endif ()
    list(APPEND _ids "${_id}")
    file(READ "${_source}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
    # Checkouts differ in BOM and line endings, and the embedded text must not
    string(REGEX REPLACE "^0xef,0xbb,0xbf," "" _hex "${_hex}")
    string(REPLACE "0x0d," "" _hex "${_hex}")
    string(REGEX REPLACE "(${_row})" "\\1\n" _hex "${_hex}")
    string(APPEND _arrays "const unsigned char s${_index}[] = {\n${_hex}0x00};\n")
    string(APPEND _entries "      {\"${_id}\", s${_index}, sizeof(s${_index}) - 1},\n")
    math(EXPR _index "${_index} + 1")
  endforeach ()
  if (_entries STREQUAL "")
    set(_body "  return {};\n")
  else ()
    set(_body "  static constexpr EmbeddedShader table[] = {\n${_entries}  };\n  return table;\n")
  endif ()
  file(WRITE "${AURORA_WGSL_OUTPUT}.tmp"
    "// Generated by AuroraEmbedShaders.cmake; do not edit\n"
    "#include \"${AURORA_WGSL_HEADER}\"\n\n"
    "namespace {\n${_arrays}} // namespace\n\n"
    "namespace aurora::render::shaders {\n"
    "std::span<const EmbeddedShader> ${AURORA_WGSL_TABLE}() noexcept {\n${_body}}\n"
    "} // namespace aurora::render::shaders\n")
  # An unchanged shader set must not recompile the table
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${AURORA_WGSL_OUTPUT}.tmp" "${AURORA_WGSL_OUTPUT}")
  file(REMOVE "${AURORA_WGSL_OUTPUT}.tmp")
  return ()
endif ()

include_guard(GLOBAL)
set(_AURORA_EMBED_SHADERS_SCRIPT "${CMAKE_CURRENT_LIST_FILE}" CACHE INTERNAL "")

function(aurora_embed_wgsl target)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "ROOT;TABLE;HEADER;OUTPUT" "SOURCES")
  foreach (_key IN ITEMS ROOT TABLE HEADER OUTPUT)
    if (NOT arg_${_key})
      message(FATAL_ERROR "aurora_embed_wgsl(${target}): ${_key} is required")
    endif ()
  endforeach ()
  get_filename_component(_root "${arg_ROOT}" ABSOLUTE)
  get_filename_component(_header "${arg_HEADER}" ABSOLUTE)
  set(_abs "")
  foreach (_source IN LISTS arg_SOURCES)
    get_filename_component(_path "${_source}" ABSOLUTE)
    list(APPEND _abs "${_path}")
  endforeach ()
  # A list file keeps the sources out of -D, where ';' would split them
  set(_list "${CMAKE_CURRENT_BINARY_DIR}/${arg_TABLE}.wgsl_list")
  list(JOIN _abs "\n" _content)
  file(GENERATE OUTPUT "${_list}" CONTENT "${_content}\n")
  add_custom_command(OUTPUT "${arg_OUTPUT}"
    COMMAND ${CMAKE_COMMAND} -DAURORA_WGSL_LIST=${_list} -DAURORA_WGSL_ROOT=${_root}
            -DAURORA_WGSL_OUTPUT=${arg_OUTPUT} -DAURORA_WGSL_TABLE=${arg_TABLE}
            -DAURORA_WGSL_HEADER=${_header} -P ${_AURORA_EMBED_SHADERS_SCRIPT}
    DEPENDS ${_abs} ${_AURORA_EMBED_SHADERS_SCRIPT} ${_list}
    COMMENT "Embedding WGSL (${arg_TABLE})"
    VERBATIM)
  target_sources(${target} PRIVATE "${arg_OUTPUT}")
endfunction()
